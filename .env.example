# Copy to ".env" on the SERVER and fill in. NEVER commit the real .env (it has secrets).
# cp .env.example .env  &&  nano .env

# ── Fyers API app (from your Fyers API dashboard) ──────────────────────────────
FYERS_APP_ID=WVDZUTO6HL-100
FYERS_SECRET_KEY=your_app_secret_here

# ── Fyers account login (for unattended headless TOTP auth) ────────────────────
FYERS_FY_ID=your_fyers_login_id          # e.g. XS04195
FYERS_PIN=1234                            # your 4-digit trading PIN
FYERS_TOTP_SECRET=BASE32SECRETFROMFYERS   # Fyers → Profile → enable TOTP; use the
                                          # base32 secret behind the QR (not the code)
FYERS_REDIRECT_URI=http://127.0.0.1:8085  # the redirect URI registered for the app

# ── Public access via Caddy (TLS + password) ──────────────────────────────────
SITE_ADDRESS=trade.yourdomain.com         # a domain you point at the VM, OR ":443"
BASIC_AUTH_USER=you
# bcrypt hash — generate with:
#   docker run --rm caddy caddy hash-password --plaintext 'choose-a-strong-password'
BASIC_AUTH_HASH=$2a$14$REPLACE_WITH_GENERATED_HASH

# Public entry point. SITE_ADDRESS comes from .env:
#   - a domain  (trade.example.com)  → Caddy auto-provisions a real Let's Encrypt cert
#   - or ":443"                       → Caddy serves the VM IP with an internal cert
#                                       (browser shows a one-time "not trusted" warning)
{$SITE_ADDRESS} {
	# HTTP basic auth — the password gate. BASIC_AUTH_HASH is a bcrypt hash:
	#   docker run --rm caddy caddy hash-password --plaintext 'your-password'
	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# Forward to the private app container over the internal docker network.
	reverse_proxy tradebot:8050

	encode gzip
	log {
		output file /data/access.log
	}
}
